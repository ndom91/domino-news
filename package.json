{
  "name": "domino-news",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm --filter @dn/web dev",
    "dev:worker": "pnpm --filter @dn/worker dev",
    "build": "pnpm --filter @dn/web build",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "playroom": "pnpm --filter @dn/playroom start",
    "mobile:build:preview": "pnpm --filter @dn/mobile build:preview:local",
    "db:generate": "pnpm --filter @dn/db generate",
    "db:migrate": "pnpm --filter @dn/db migrate",
    "cli": "pnpm --filter @dn/worker cli"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@dn/api-client": "workspace:*",
    "@dn/db": "workspace:*",
    "@dn/domain": "workspace:*",
    "@dn/inference": "workspace:*",
    "@dn/jobs": "workspace:*",
    "@dn/schemas": "workspace:*",
    "@dn/server": "workspace:*",
    "@dn/ui": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "drizzle-orm": "0.45.3",
    "pg": "8.23.1",
    "pg-boss": "12.36.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
