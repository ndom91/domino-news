{
  "name": "domino-news",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm --filter @dn/web dev",
    "dev:worker": "pnpm --filter @dn/worker dev",
    "build": "pnpm --filter @dn/web build",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "playroom": "pnpm --filter @dn/playroom start",
    "db:generate": "pnpm --filter @dn/db generate",
    "db:migrate": "pnpm --filter @dn/db migrate",
    "cli": "pnpm --filter @dn/worker cli"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@dn/api-client": "workspace:*",
    "@dn/db": "workspace:*",
    "@dn/domain": "workspace:*",
    "@dn/inference": "workspace:*",
    "@dn/jobs": "workspace:*",
    "@dn/schemas": "workspace:*",
    "@dn/server": "workspace:*",
    "@dn/ui": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "drizzle-orm": "0.45.3",
    "pg": "8.23.1",
    "pg-boss": "12.36.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
