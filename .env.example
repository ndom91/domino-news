# Copy to .env. Values below work with infra/compose/compose.yaml.

DATABASE_URL=postgres://dn:dn@localhost:5442/dn
TYPESENSE_URL=http://localhost:8108
TYPESENSE_API_KEY=dev-typesense-key

# Auth (better-auth). Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:4000
# Optional temporary domain aliases (comma-separated exact origins, same protocol as above).
# Migration: BETTER_AUTH_URL=https://dominowire.com and the old origin here. Remove after rollout.
# BETTER_AUTH_ADDITIONAL_ORIGINS=https://domino-wire.ndo.dev
# Compose only: host address the web port binds to. Use the private/tailnet IP your reverse
# proxy reaches this host on. 0.0.0.0 bypasses UFW and makes the port public.
# WEB_BIND=127.0.0.1
# WEB_PORT=4000
# Header carrying the real client IP, for auth rate limits behind a proxy. Behind Cloudflare:
# cf-connecting-ip (only safe if the origin accepts traffic from Cloudflare alone).
# AUTH_IP_HEADERS=cf-connecting-ip
# Optional Google sign-in: shown only when both client values are set.
# Authorised redirect URI in Google Cloud: ${BETTER_AUTH_URL}/api/auth/callback/google
# Any Google account can create an account.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Optional Sign in with Apple (iOS app only): enabled when all three are set. The key is the
# Sign in with Apple .p8 from the Apple Developer portal, PEM on one line with literal \n. It
# signs the token exchange at sign-in and the token revocation App Review requires on deletion.
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# The iOS bundle ID: identity tokens must be issued for it. Defaults to dev.ndo.dominonews.
# APPLE_BUNDLE_ID=dev.ndo.dominonews
# The Expo app's URL scheme (app.json "scheme"); its sign-in requests are trusted from it.
# EXPO_APP_SCHEME=dominonews

# Optional publisher logos from logo.dev. Use the secret key (sk_…), not the publishable one.
# Logos are fetched once per publisher per server start and cached by browsers and Cloudflare.
# LOGO_DEV_API_KEY=

# Inference: "fixture" (deterministic, GPU-free) or "local" (OpenAI-compatible endpoints).
INFERENCE_MODE=fixture
INFERENCE_BASE_URL=https://llama-dash.puff.lan/v1
INFERENCE_API_KEY=
# Optional PEM file for a private CA that signs the inference endpoint's certificate.
INFERENCE_CA_CERT=
INFERENCE_GENERATION_MODEL=gemma-4-26B-A4B
# Optional System One model for high-confidence Story matches. Gemma remains the fallback.
# INFERENCE_MATCH_DECISION_MODEL=kev
# MATCH_DECISION_CONFIDENCE=0.8
INFERENCE_EMBEDDING_MODEL=embeddinggemma-2

# Optional on-demand audio briefing prototype (full OpenAI-compatible speech endpoint).
AUDIO_PROTOTYPE_TTS_URL=
# Optional if the speech service requires authentication.
AUDIO_PROTOTYPE_TTS_API_KEY=
AUDIO_PROTOTYPE_TTS_MODEL=kokoro
AUDIO_PROTOTYPE_TTS_VOICE=af_heart
# Concurrency caps for the inference dispatcher.
EMBEDDING_CONCURRENCY=2
GENERATION_CONCURRENCY=2
# Live overrides for these values are available to admins on /pipeline.
PUBLISHED_SUMMARY_DEBOUNCE_SECONDS=180
SUMMARY_UPDATE_ASSESSMENT_MAX_ARTICLES=5

# Optional tuning (defaults shown).
# SUMMARY_MAX_AGE_HOURS=336   # live mode: skip summaries for stories first reported longer ago
# DB_POOL_MAX=10
# EVENT_RETENTION_DAYS=7      # delete delivered search outbox/inbox events after this many days
# Expo Push Service delivery (optional access token for enhanced Expo push security).
# EXPO_PUSH_DELIVERY_CRON=*/5 * * * *
# EXPO_ACCESS_TOKEN=

# Ingestion: "fixture" reads fixtures/rss/*.xml; "live" polls real feeds.
INGEST_MODE=fixture
FEED_POLL_CRON=*/15 * * * *
# Articles older than this are backfill (rate-limited, pausable); newer ones are fresh.
FRESH_WINDOW_HOURS=12
BACKFILL_ADMIT_PER_MINUTE=20
# A Story is summarised and published only once this many distinct newsrooms cover it
# (official sources don't count). Live feeds skip items published more than N days ago.
MIN_PUBLISH_OUTLETS=2
MAX_ARTICLE_AGE_DAYS=3

# Dev-only summary editing endpoint and UI.
ENABLE_SUMMARY_EDITING=true

# Local dev account used by the Playwright smoke tests (create it with `pnpm cli user:create`).
# E2E_BASE_URL=http://localhost:4000
DEV_USERNAME=dev
DEV_PASSWORD=dev-password-change-me
