# Optional offsite copy for `scripts/deploy.sh backup` (restic). Copy to backup.env (git-ignored).
# Without RESTIC_REPOSITORY, backups stay local in backups/ only.

# Pick one repository:
# RESTIC_REPOSITORY=sftp:backup@backup-host:/srv/restic/domino-news
# RESTIC_REPOSITORY=s3:s3.eu-central-003.backblazeb2.com/my-bucket/domino-news
RESTIC_REPOSITORY=

# The repository password. Lose it and the backups can't be read: keep a copy in your
# password manager. A file outside the repo is safer than putting the password here.
RESTIC_PASSWORD_FILE=/root/.config/restic/domino-news.pass

# S3-compatible backends only (B2, Hetzner, Wasabi, AWS):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Local dumps older than this are deleted (restic keeps its own history).
# BACKUP_KEEP_DAYS=14
