# Use your LAN address for a physical device. Do not include /api/auth or /api/v1.
EXPO_PUBLIC_API_URL=http://192.168.1.10:4000
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Required only for a custom development build using the HTTP URL above.
APP_VARIANT=development
